# Copy to .env (git-ignored) and fill in. The flightwall CLI loads .env from the project root;
# command-line flags override these values.

# Roku in developer mode
ROKU_HOST=192.168.1.100
ROKU_DEV_PASSWORD=your-developer-password

# Package-signing key from `flightwall genkey` (needed only for Channel Store packages)
ROKU_DEV_ID=
ROKU_SIGNING_PASSWORD=
