<?xml version="1.0" encoding="UTF-8"?>
<component name="SettingsPanel" extends="Group">
  <interface>
    <field id="settings" type="assocarray" onChange="onSettingsChanged"/>
    <field id="message" type="string" onChange="onMessageChanged"/>
    <field id="focusRow" type="string"/>
    <field id="result" type="assocarray" alwaysNotify="true"/>
  </interface>
  <script type="text/brightscript" uri="pkg:/source/lib/util.brs"/>
  <script type="text/brightscript" uri="pkg:/source/lib/settings.brs"/>
  <script type="text/brightscript" uri="pkg:/components/SettingsPanel.brs"/>
  <children>
    <Rectangle id="backdrop" width="1280" height="720" color="0x000000DD"/>
    <Rectangle id="card" translation="[200, 40]" width="880" height="640" color="0x0D1117FF">
      <Label id="title" translation="[40, 24]" width="800" color="0xFFFFFFFF" text="FlightWall settings"/>
      <Label id="messageLabel" translation="[40, 64]" width="800" height="60" wrap="true" color="0xFFD166FF"/>
      <LabelList id="list" translation="[40, 132]" itemSize="[800, 38]" itemSpacing="[0, 2]" numRows="12" color="0xC9D1D9FF" focusedColor="0xFFFFFFFF" vertFocusAnimationStyle="floatingFocus"/>
      <Label id="help" translation="[40, 600]" width="800" color="0x6E7681FF" text="OK changes a row  -  Back cancels  -  choose Save and apply when done"/>
    </Rectangle>
  </children>
</component>
